# =========================================================================
# SCOUTBOOK — Vercel 伺服器端環境變數範本（切勿加上 VITE_ 前綴）
# 前端 bundle 只會拿到空值；所有密碼與網址均在伺服器端讀取。
# =========================================================================

# 1. 領袖模式密碼（必填以啟用當面掃描核簽的「領袖只讀模式」）
#    比較於 /api/leader，使用 crypto.timingSafeEqual，絕不送入前端。
#    Vercel → Project → Settings → Environment Variables
#      Name = LEADER_CODE   Value = 你的領袖密碼（4 位或以上，隨時可改）  Scope = Production
#    未設定則自動隱藏領袖模式入口（純成員版）。本機 `npm run dev` 未設定時預設 1234 方便測試。
LEADER_CODE=

# 2. 童軍支部進度及行政平台 scoutbadge 網址（零金鑰：BOOK 不儲存任何 Google Sheet 網址或 API key）
#    BOOK 的 /api/scoutbadge 於伺服器端向 <origin>/api/troops 自動讀取「已登記旅團」清單，
#    供成員在連接表單的下拉選單選取；登入／讀取／待核實提交經 <origin>/api/proxy 轉發。
#    選單找不到自己的旅團時，介面會引導成員前往此網址開戶及登記旅團。
#    BADGE → BOOK：只錄入領袖在 scoutbadge 已核實（confirmed）的 progress / otherBadges，
#    pendingRequests 永不錄入；BOOK → BADGE：一律寫成 status: 'pending'，由領袖 CONFIRM。
#    未連接並登入 scoutbadge 前，不可匯出或匯入 scoutbadge 進度檔（完整紀錄冊備份不受影響）。
#    預設值 https://scoutbadge.vercel.app 已於 2026-11-10 核實為 scoutbadge 的正式網址。
#    只接受 https，而且只取 origin（路徑會被丟棄）；留空或填錯即自動使用預設值。
#    如 scoutbadge 另行部署於其他網址，請改為實際 origin。
SCOUTBADGE_ORIGIN=https://scoutbadge.vercel.app

# 3. 個別旅團直連（選填，一般不需要）。每個旅團一組，格式 TROOP_<id>_<KEY>
#    <id> 為旅團編號（英數字或底線，最長 32 字元），<KEY> 為 NAME / EN / BACKEND / APIKEY：
#      NAME     旅團中文名稱（必填）
#      EN       旅團英文名稱（選填）
#      BACKEND  該旅團自己的 Google Apps Script 網址（必填，只接受
#               https://script.google.com/macros/s/…/exec）
#      APIKEY   該後端的 API key（必填；只留在伺服器，永不回傳前端）
#    NAME、BACKEND、APIKEY 三者齊備才生效；生效後該旅團會加入下拉選單，
#    而且它的請求直接送往 BACKEND，不經 scoutbadge 的 /api/proxy。
#    例：
#      TROOP_1234_NAME=第 1234 旅
#      TROOP_1234_EN=1234th Group
#      TROOP_1234_BACKEND=https://script.google.com/macros/s/AKfy…/exec
#      TROOP_1234_APIKEY=該後端的 API key
#    一般情況只需設定 SCOUTBADGE_ORIGIN：旅團清單及金鑰一律由 scoutbadge 管理。
TROOP_EXAMPLE_NAME=
TROOP_EXAMPLE_EN=
TROOP_EXAMPLE_BACKEND=
TROOP_EXAMPLE_APIKEY=

# 4. 本機測試允許 127.0.0.1 目標（僅非 Vercel 環境且值為 1 時生效）
SCOUTBOOK_PROXY_TEST=0
